# =====================================================================
#  Конфиг для локальной разработки.  cp .env.dev.example .env.dev
#  Используется командами make dev-* (ENV_FILE=.env.dev). Не для сервера!
# =====================================================================

SITE_URL=http://localhost:3000
SITE_NAME=Квипекс
DEBUG=true

# Postgres из docker-compose.dev.yml (make dev-db)
DATABASE_URL=postgresql://quipex:quipex@localhost:5433/quipex
# Без Docker можно взять SQLite (часть поиска по кириллице будет регистрозависимой):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db   (файл появится в backend/)

SECRET_KEY=dev-only-secret-change-me-0123456789abcdef
ADMIN_EMAIL=admin@localhost.dev
ADMIN_PASSWORD=admin12345

# в разработке токены покороче — удобно проверять обновление сессии
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=7

MEDIA_DIR=./backend/media

PARSER_BASE_URL=https://e8.ru
PARSER_CATALOG_PATH=/catalog/
PARSER_CONCURRENCY=6
PARSER_DELAY_SECONDS=0.1
PARSER_DOWNLOAD_IMAGES=true
PARSER_AUTO_SYNC_HOURS=0

# обмен с 1С: для проверки каркаса протокола
EXCHANGE_1C_ENABLED=true
EXCHANGE_1C_LOGIN=1c
EXCHANGE_1C_PASSWORD=1c-dev-password

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
NOTIFY_EMAIL=
