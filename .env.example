# =====================================================================
#  Квипекс — настройки. Скопируйте файл:  cp .env.example .env
#  и заполните значения, отмеченные «ОБЯЗАТЕЛЬНО».
# =====================================================================

# --- Сайт -------------------------------------------------------------
# ОБЯЗАТЕЛЬНО: публичный адрес сайта (используется в sitemap, SEO, ссылках в уведомлениях)
SITE_URL=https://quipex.ru
# Адрес для веб-сервера Caddy:
#   «quipex.ru, www.quipex.ru» — домен(ы) с автоматическим HTTPS (DNS должен указывать на сервер)
#   «:80» — без HTTPS, например для проверки по IP-адресу
SITE_ADDRESS="quipex.ru, www.quipex.ru"
SITE_NAME=Квипекс
# Порты на сервере
HTTP_PORT=80
HTTPS_PORT=443

# --- База данных (PostgreSQL в docker-compose) ------------------------
POSTGRES_USER=quipex
# ОБЯЗАТЕЛЬНО: придумайте надёжный пароль
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=quipex
# Альтернатива: полный адрес внешней БД (тогда POSTGRES_* выше не используются)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- Безопасность -----------------------------------------------------
# ОБЯЗАТЕЛЬНО: случайная строка (сгенерировать: openssl rand -hex 32)
SECRET_KEY=change-me
# Сессии: короткий access-токен + refresh-токен, который обновляется при каждом использовании.
# Пользователь остаётся в системе, пока заходит хотя бы раз в REFRESH_TOKEN_EXPIRE_DAYS дней.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Первый администратор — создаётся при старте, если такого email ещё нет.
# ОБЯЗАТЕЛЬНО поменяйте пароль. Дальше пользователей можно вести в админке.
ADMIN_EMAIL=admin@quipex.ru
ADMIN_PASSWORD=change-me-admin-password

# --- Импорт товаров с сайта-источника ---------------------------------
PARSER_BASE_URL=https://e8.ru
PARSER_CATALOG_PATH=/catalog/
# Параллельных запросов и пауза между ними (не перегружаем источник)
PARSER_CONCURRENCY=4
PARSER_DELAY_SECONDS=0.3
PARSER_TIMEOUT_SECONDS=30
# Скачивать фото на свой сервер (true) или ссылаться на источник (false)
PARSER_DOWNLOAD_IMAGES=true
# Автоматическая синхронизация каждые N часов (0 — только вручную из админки)
PARSER_AUTO_SYNC_HOURS=24
# Слаги категорий источника, которые не нужно импортировать (через запятую)
PARSER_SKIP_CATEGORIES=

# --- Обмен с 1С (CommerceML, «Обмен с сайтом») -----------------------
# Адрес для настройки узла обмена в 1С: https://ваш-домен/api/1c/exchange
# Сейчас готовы авторизация и приём файлов; загрузка товаров/цен и выгрузка заказов — следующий этап.
EXCHANGE_1C_ENABLED=false
EXCHANGE_1C_LOGIN=
EXCHANGE_1C_PASSWORD=
EXCHANGE_1C_FILE_LIMIT_MB=50

# --- Уведомления о заказах и заявках (необязательно) ------------------
# Telegram: создайте бота у @BotFather, узнайте chat_id (например, через @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (SMTP). Порт 465 — SSL, 587 — STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_EMAIL=

# --- Прочее -----------------------------------------------------------
# Сколько секунд фронтенд кеширует ответы API (цены/товары обновятся с этой задержкой)
API_CACHE_SECONDS=30
# Максимальный размер загружаемого изображения, МБ
MAX_UPLOAD_MB=15
# true — включает /api/docs (Swagger) и подробные логи. На проде держите false.
DEBUG=false
